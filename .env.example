# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you have.
# The application boots WITHOUT a database: data endpoints then return
# DATABASE_NOT_CONFIGURED instead of crashing. That is deliberate, so the API
# can be built, started and smoke-tested before a Supabase project exists.
# ---------------------------------------------------------------------------

# --- Required for live data -------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" (port 5432) string, not the direct connection, so
# the app works with IPv4-only hosts and PgBouncer.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Only needed if a client talks to Supabase directly (auth, storage, Realtime).
# This API never requires them.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Set to true when running behind a proxy (Vercel, nginx, Cloudflare) so that
# rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=false

# Comma-separated list of allowed browser origins, or * for any.
# Production should name the real frontend domains, not *.
CORS_ORIGINS=*

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Admin endpoints --------------------------------------------------------
# Required by POST /api/admin/graph/refresh, GET /api/admin/routes/aliases and
# POST /api/admin/routes/alias, sent as the x-admin-key header.
# Leave it EMPTY to disable those routes: they will return 503 rather than
# defaulting to open.
ADMIN_KEY=

# --- Transfer detection -----------------------------------------------------
# Hard ceiling for a walkable transfer, in metres (spec section 12).
MAX_TRANSFER_DISTANCE_METERS=300
# Walk penalty used only when a transfer pair has no coordinates. Bus and tram
# data has no coordinates, so this is what intermodal transfers cost today.
DEFAULT_TRANSFER_MINUTES=5
# Minimum normalised-name similarity for two stops to be treated as the same
# interchange when coordinates are missing. 0.9 links exact matches and nothing
# else; lowering it will start inventing transfers between similar names.
TRANSFER_NAME_SIMILARITY_THRESHOLD=0.9
# Allowance for changing vehicle at a stop when the change happens at the SAME
# stop, so no walk between distinct places is involved. Reported as a TRANSFER
# journey segment with timingConfidence ESTIMATED. Set to 0 to time such a change
# as costing nothing, which is almost certainly wrong.
MIN_INTERCHANGE_MINUTES=5

# --- Data import ------------------------------------------------------------
# Folder containing the source CSVs. Relative paths resolve against the project
# root; the importer also checks DATA_DIR under your home directory and
# ~/Downloads as a fallback.
DATA_DIR=data
# Operator recorded for route-stop rows, whose source CSVs have no operator
# column. The bus/tram route-stop files are WBTC; the timetable file's own
# operator column (CSTC) is always preserved as supplied.
DEFAULT_ROUTE_STOP_OPERATOR=WBTC

# --- Graph cache ------------------------------------------------------------
# How long a built transport graph stays fresh in process memory.
GRAPH_CACHE_TTL_SECONDS=900
# Minimum gap between two graph rebuilds, so a burst of traffic after an import
# cannot stampede the database. Override per request with ?force=true.
GRAPH_REBUILD_MIN_INTERVAL_SECONDS=30
