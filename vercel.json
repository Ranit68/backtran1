{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/",
      "destination": "/api/index.ts"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.ts"
    }
  ]
}
