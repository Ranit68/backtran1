{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/.*",
      "dest": "/api/index.ts"
    }
  ]
}
