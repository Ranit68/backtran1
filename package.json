{
  "name": "transport-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Kolkata Multi-Modal Transport Platform - Backend REST API (Bus + Metro; Ferry adapter reserved, Tram retired)",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "verify": "npm run typecheck && npm run typecheck:test && npm test && npm run build",
    "migrate": "tsx src/db/migrate.ts",
    "import:bus-routes": "tsx src/scripts/import-bus-routes.ts",
    "import:bus-timetable": "tsx src/scripts/import-bus-timetable.ts",
    "import:all": "tsx src/scripts/import-all.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
